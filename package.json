{
  "name": "skill-x",
  "version": "0.2.0",
  "description": "skills.sh-compatible skills that stay current with upstreams, compose with each other, and detect drift across schemas and code.",
  "type": "module",
  "private": true,
  "bin": {
    "skill-sync": "tools/sync.mjs",
    "skill-compose": "tools/compose.mjs",
    "skill-x-mcp": "tools/mcp-server.mjs"
  },
  "scripts": {
    "sync": "node tools/sync.mjs",
    "compose": "node tools/compose.mjs",
    "mcp": "node tools/mcp-server.mjs",
    "gen-hooks": "node tools/gen-hooks.mjs && biome format --write .claude-plugin/plugin.json",
    "validate": "node tools/skill-validate.mjs",
    "audit": "node tools/audit.mjs",
    "audit:write": "node tools/audit.mjs --write",
    "audit:check": "node tools/audit.mjs --check",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check": "npm run lint && npm run validate && npm run test",
    "example:sync": "SKILL_X_SKILLS_DIR=examples/skills SKILL_X_MANIFEST_DIR=examples/manifest node tools/sync.mjs",
    "example:compose": "SKILL_X_SKILLS_DIR=examples/skills node tools/compose.mjs",
    "example:validate": "SKILL_X_SKILLS_DIR=examples/skills node tools/skill-validate.mjs",
    "example:check": "npm run example:validate && npm run example:compose",
    "test": "node --test tools/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.15"
  }
}
