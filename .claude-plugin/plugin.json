{
  "name": "skill-x",
  "description": "Skills that stay current with upstreams, compose with each other, and detect drift across schemas and code.",
  "version": "0.2.0",
  "skills": [
    "skills/skill-sync",
    "skills/skill-compose",
    "skills/skill-audit",
    "skills/schema-drift",
    "skills/code-drift"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/hook-sync-on-pkg.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/compose.mjs"
          }
        ]
      }
    ]
  }
}
